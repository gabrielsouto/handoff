#!/bin/sh
# Runs tools/handoff.py from this folder against any repository.
#   ./handoff doctor --repo /var/www/html/soutog/pgedigital
#   HANDOFF_REPO=/var/www/html/soutog/pgedigital ./handoff status
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
py=""
# Probe by running it: on Windows a "python3" on PATH may be the Microsoft
# Store alias, which resolves but is not an interpreter.
for candidate in python3 python py; do
    if "$candidate" -c "import sys" >/dev/null 2>&1; then
        py=$candidate
        break
    fi
done
if [ -z "$py" ]; then
    echo "handoff: no working Python 3 interpreter found on PATH" >&2
    exit 2
fi
exec "$py" "$here/tools/handoff.py" "$@"
